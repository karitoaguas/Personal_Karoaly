   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-repair">Concentrated students working with laptops in the university. Boys and girls wearing colorful casual clothes. Guys reading, studuing, learning, writing. Looking calm and educated. Friendly groupmates.</rdf:li>
    </rdf:Alt>
